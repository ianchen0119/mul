FROM golang:1.24-bookworm

# Install required packages for eBPF development
RUN apt-get update && apt-get install -y \
    clang \
    llvm \
    libbpf-dev \
    linux-headers-generic \
    build-essential \
    iproute2 \
    iputils-ping \
    tcpdump \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum* ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build eBPF program
RUN cd src && make

# Build Go application
RUN cd cmd/loader && go build -o /app/loader

CMD ["/app/loader"]
